{
	"name": "x-game",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web",
		"dev:server": "turbo run dev -F server",
		"dev:mcp": "turbo run dev -F mcp-server",
		"db:push": "turbo run db:push -F @x-game/db",
		"db:studio": "turbo run db:studio -F @x-game/db",
		"db:generate": "turbo run db:generate -F @x-game/db",
		"db:migrate": "turbo run db:migrate -F @x-game/db",
		"db:check": "bash scripts/check-drizzle.sh",
		"check": "biome check --write .",
		"mcp:dev": "npx -y @modelcontextprotocol/inspector"
	},
	"dependencies": {
		"@x-game/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@types/node": "catalog:",
		"@x-game/config": "workspace:*",
		"lefthook": "^2.1.9",
		"turbo": "^2.9.16",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.19.0",
	"pnpm": {
		"overrides": {
			"vite@<=6.4.2": "6.4.3"
		}
	}
}
