# ─────────────────────────────────────────────────────────────────────────
# Required at deploy time. Copy to .env and fill in real values. The deploy
# script (`./scripts/deploy.sh`) sources .env automatically and passes the
# values into SAM via --parameter-overrides or environment substitution.
# ─────────────────────────────────────────────────────────────────────────

# AWS credentials + target region. Usually picked up from `aws configure`,
# but you can override here for CI.
AWS_REGION=us-east-1
AWS_PROFILE=

# 32+ char secret used to sign Better-Auth session cookies. Generate with:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

# Stage to deploy: dev | staging | prod (matches samconfig.toml).
DEPLOY_STAGE=dev

# 可选：行为埋点异常通知。留空表示只采集数据，不发送飞书告警。
FEISHU_ANALYTICS_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/*****

# Optional overrides. Defaults below match samconfig.toml[stage].
# AURORA_MIN_CAPACITY=0.5
# AURORA_MAX_CAPACITY=4
# LAMBDA_MEMORY_MB=1024
# DELETION_PROTECTION=false

# 前端访问本地后端
VITE_SERVER_URL=http://localhost:3000

# Better Auth 本地地址
BETTER_AUTH_URL=http://localhost:3000

# 允许本地 Vite 前端跨域访问
CORS_ORIGIN=http://localhost:5173

# 本地 PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xgame
